# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database Settings
POSTGRES_DB=stories
POSTGRES_USER=stories_user
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Settings
REDIS_URL=redis://localhost:6379/1

# AWS S3 / MinIO Settings
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=your-minio-password-here
AWS_STORAGE_BUCKET_NAME=stories-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# MinIO Settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-minio-password-here

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800

# Rate Limiting
RATE_LIMIT_STORIES=20
RATE_LIMIT_REACTIONS=60

# Story Settings
STORY_EXPIRATION_HOURS=24

# Monitoring
GRAFANA_PASSWORD=admin

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production Settings
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
